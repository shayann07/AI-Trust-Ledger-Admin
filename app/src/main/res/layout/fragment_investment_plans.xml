<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/container_bg"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Your full original layout inside here -->
            <!-- I won't remove any of your code, just moved FAB outside -->

            <!-- Top Bar -->
            <RelativeLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="9dp"
                >

                <TextView
                    android:id="@+id/profileTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Investment Plans"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Stocks Wallet -->
            <TextView
                android:id="@+id/tvStocksWallet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/topBar"
                android:padding="16dp"
                android:text="Stocks Wallet"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardStocks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvStocksWallet"
                android:layout_marginHorizontal="4dp"
                android:paddingHorizontal="16dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/itemCardStockInvestment"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginHorizontal="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    card_view:cardCornerRadius="16dp"
                    card_view:strokeColor="@android:color/transparent"
                    card_view:strokeWidth="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_stock_gradient"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/tvWalletType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Stocks"
                            android:textAlignment="center"
                            android:textColor="@android:color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iconToggle"
                            android:layout_width="40dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="18dp"
                            android:src="@drawable/mastercard" />

                        <TextView
                            android:id="@+id/tvCardNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text=""
                            android:textColor="@android:color/white"
                            android:textSize="18sp" />

                        <Button
                            android:id="@+id/btnStocks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_marginBottom="12dp"
                            android:backgroundTint="@android:color/white"
                            android:text="Set Plan"
                            android:textColor="@android:color/black"
                            android:textSize="14sp"
                            android:translationY="-12dp" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Medicine Wallet -->
            <TextView
                android:id="@+id/tvMedicineWallet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/cardStocks"
                android:padding="16dp"
                android:text="Medicine Wallet"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardMedicine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvMedicineWallet"
                android:layout_marginHorizontal="4dp"
                android:paddingHorizontal="16dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/item_card_medicine_investment"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginHorizontal="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    card_view:cardCornerRadius="16dp"
                    card_view:strokeColor="@android:color/transparent"
                    card_view:strokeWidth="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_medicine_gradient"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/tvWalletType2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Medicine"
                            android:textAlignment="center"
                            android:textColor="@android:color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iconToggle2"
                            android:layout_width="40dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="18dp"
                            android:src="@drawable/mastercard" />

                        <Button
                            android:id="@+id/btnMedicine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_marginBottom="12dp"
                            android:backgroundTint="@android:color/white"
                            android:text="Set Plan"
                            android:textColor="@android:color/black"
                            android:textSize="14sp"
                            android:translationY="-12dp" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Forex Wallet -->
            <TextView
                android:id="@+id/tvForexWallet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/cardMedicine"
                android:padding="16dp"
                android:text="Forex Wallet"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardForex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvForexWallet"
                android:orientation="vertical"
                android:layout_marginHorizontal="4dp"
                android:paddingHorizontal="16dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/item_card_forex_investment"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginHorizontal="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    card_view:cardCornerRadius="16dp"
                    card_view:strokeColor="@android:color/transparent"
                    card_view:strokeWidth="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_background_forex"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/tvWalletType3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Forex"
                            android:textAlignment="center"
                            android:textColor="@android:color/white"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iconToggle3"
                            android:layout_width="40dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="18dp"
                            android:src="@drawable/mastercard" />

                        <Button
                            android:id="@+id/btnforex"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_marginBottom="12dp"
                            android:backgroundTint="@android:color/white"
                            android:text="Invest"
                            android:textColor="@android:color/black"
                            android:textSize="14sp"
                            android:translationY="-12dp" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>

    <!-- Floating Action Button (Fixed at Bottom-Right Corner) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:backgroundTint="@color/blue"
        android:src="@drawable/plus"
        android:tint="@android:color/white" />
</FrameLayout>
